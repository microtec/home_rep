<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{B7C2E1A4-5D3F-4E8A-9C21-7F0D2A6B3E91}</ProjectGuid>
    <ProjectVersion>19.5</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>Zonico.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
    <Base_Win32>true</Base_Win32>
    <CfgParent>Base</CfgParent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>.\bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_UnitSearchPath>src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
    <SanitizedProjectName>Zonico</SanitizedProjectName>
    <VerInfo_Locale>1040</VerInfo_Locale>
    <VerInfo_Keys>CompanyName=;FileDescription=Zonico - Gestionale Parrucchieri;FileVersion=1.0.0.0;InternalName=Zonico;LegalCopyright=;OriginalFilename=Zonico.exe;ProductName=Zonico;ProductVersion=1.0.0.0</VerInfo_Keys>
    <Icon_MainIcon>$(BDS)\bin\delphi_PROJECTICON.ico</Icon_MainIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win32)'!=''">
    <DCC_UsePackage>vcl;rtl;dbrtl;vcldb;FireDAC;FireDACIBDriver;FireDACCommonDriver;FireDACCommon;$(DCC_UsePackage)</DCC_UsePackage>
    <BT_BuildType>Debug</BT_BuildType>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <UWP_DelphiLogo44>$(BDS)\bin\Artwork\Windows\UWP\delphi_UwpDefault_44.png</UWP_DelphiLogo44>
    <UWP_DelphiLogo150>$(BDS)\bin\Artwork\Windows\UWP\delphi_UwpDefault_150.png</UWP_DelphiLogo150>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    <DCC_DebugDCUs>true</DCC_DebugDCUs>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    <DCC_DebugInformation>0</DCC_DebugInformation>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="src\uDM.pas">
      <Form>DM</Form>
      <DesignClass>TDataModule</DesignClass>
    </DCCReference>
    <DCCReference Include="src\uSessione.pas"/>
    <DCCReference Include="src\uLogin.pas">
      <Form>frmLogin</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uMain.pas">
      <Form>frmMain</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uBaseAnag.pas">
      <Form>frmBaseAnag</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uClienti.pas">
      <Form>frmClienti</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uClienteDett.pas">
      <Form>frmClienteDett</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uOperatori.pas">
      <Form>frmOperatori</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uServizi.pas">
      <Form>frmServizi</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uProdotti.pas">
      <Form>frmProdotti</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uUtenti.pas">
      <Form>frmUtenti</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uAgenda.pas">
      <Form>frmAgenda</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uAppuntamentoDett.pas">
      <Form>frmAppuntamentoDett</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uVendite.pas">
      <Form>frmVendite</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uVenditaDett.pas">
      <Form>frmVenditaDett</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <DCCReference Include="src\uReport.pas">
      <Form>frmReport</Form>
      <FormType>dfm</FormType>
    </DCCReference>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">Zonico.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
      </Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
  <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
